{
  "name": "Telegram",
  "description": "Чат, пристыкованный к краю стола",
  "specialType": "telegram",
  "simulate": {
    "module": "widget.js",
    "function": "renderTelegramWidget",
    "sandbox": "<div class=\"widget-header\"></div><div class=\"widget-body\"></div>"
  },
  "motion": {
    "open": ".tg-rail-toggle"
  },
  "tints": [
    {
      "id": "telegram",
      "label": "Telegram",
      "default": "peach",
      "role": "social"
    }
  ],
  "lookOptions": [
    {
      "field": "avatarColor",
      "label": "Аватары Telegram",
      "options": [
        [
          false,
          "Чёрно-белые"
        ],
        [
          true,
          "Цветные"
        ]
      ]
    }
  ],
  "backend": true
}
