<?xml version="1.0" encoding="UTF-8"?>
<!--
  Повышенный хелпер: поднимает sing-box с TUN и сразу выходит. Хелпер живёт
  рядом с программой (каталог установки), а не в каталоге данных — путь
  подставляется вместо @INSTALL_DIR@ при регистрации.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Elevated helper: launches the wallpaper VPN core (sing-box with TUN) and exits immediately. Started/stopped on demand by unidtk.exe (which itself runs unelevated).</Description>
  </RegistrationInfo>
  <Triggers />
  <Principals>
    <Principal id="Author">
      <UserId>admin</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>@INSTALL_DIR@\vpn-helper.exe</Command>
      <Arguments>start</Arguments>
    </Exec>
  </Actions>
</Task>
